{
  "title": "EntityDescriptionsDoc",
  "description": "LLM-generated description of a book entity (character, place, spell, etc.)",
  "additionalProperties": false,
  "required": [
    "createdAt",
    "updatedAt",
    "bookId",
    "bookChunkId",
    "name",
    "type"
  ],
  "properties": {
    "_id": {
      "description": "Entity description unique identifier",
      "bsonType": "objectId"
    },
    "createdAt": {
      "description": "Creation timestamp",
      "bsonType": "date"
    },
    "updatedAt": {
      "description": "Last update timestamp",
      "bsonType": "date"
    },
    "bookId": {
      "description": "Reference to the parent book",
      "bsonType": "objectId"
    },
    "bookChunkId": {
      "description": "Reference to the originating book chunk",
      "bsonType": "objectId"
    },
    "bookChunkIds": {
      "description": "References to book chunks where the entity is found",
      "items": {
        "bsonType": "objectId"
      },
      "bsonType": "array"
    },
    "name": {
      "description": "Entity name",
      "bsonType": "string"
    },
    "type": {
      "description": "Entity type (character, place, spell, etc.)",
      "bsonType": "string"
    },
    "summary": {
      "description": "LLM-generated summary of the entity",
      "bsonType": "string"
    },
    "role": {
      "description": "Narrative role of the entity",
      "bsonType": "string"
    },
    "traits": {
      "description": "List of notable traits",
      "items": {
        "bsonType": "string"
      },
      "bsonType": "array"
    },
    "importantLocations": {
      "description": "Important locations associated with the entity",
      "items": {
        "bsonType": "string"
      },
      "bsonType": "array"
    },
    "importantRelationships": {
      "description": "Important relationships with other entities",
      "items": {
        "bsonType": "string"
      },
      "bsonType": "array"
    },
    "aliases": {
      "description": "Alternate surface forms for this entity within the same book",
      "items": {
        "bsonType": "string"
      },
      "bsonType": "array"
    },
    "mentionCount": {
      "minimum": 0,
      "description": "Number of entity mention occurrences recorded for this entity in this book",
      "bsonType": "int"
    },
    "firstSeenChunkIndex": {
      "minimum": 0,
      "bsonType": "int"
    },
    "lastSeenChunkIndex": {
      "minimum": 0,
      "bsonType": "int"
    },
    "descriptionVersion": {
      "minimum": 0,
      "description": "Monotonic counter incremented whenever the summary/description is distilled",
      "bsonType": "int"
    },
    "lastDistilledMentionCount": {
      "minimum": 0,
      "description": "Mention count at the time of last distillation (used to avoid over-distilling)",
      "bsonType": "int"
    },
    "descriptionUpdatedAt": {
      "bsonType": "date"
    }
  },
  "bsonType": "object"
}