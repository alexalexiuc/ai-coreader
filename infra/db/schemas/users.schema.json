{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/users.schema.json",
  "title": "users",
  "description": "Users collection storing authentication credentials and profile metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "createdAt",
    "updatedAt",
    "firstName",
    "lastName",
    "email",
    "password"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "format": "objectId",
      "description": "User unique identifier"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "firstName": {
      "type": "string",
      "description": "User's given name"
    },
    "lastName": {
      "type": "string",
      "description": "User's family name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "User email address (unique)"
    },
    "password": {
      "type": "string",
      "description": "Hashed password for authentication"
    }
  }
}
