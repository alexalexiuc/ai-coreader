{
  "name": "ai-coreader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./scripts/dev.js",
    "dev:win": "powershell -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:unix": "bash ./scripts/dev.sh",
    "docker:up": "bash ./scripts/up-docker.sh",
    "docker:down": "bash ./scripts/up-docker.sh --down",
    "docker:up:win": "powershell -ExecutionPolicy Bypass -File ./scripts/up-docker.ps1",
    "app:dev": "npm --prefix coreader-app run dev",
    "app:start": "npm --prefix coreader-app run start",
    "worker:run": "cd coreader-worker && go run .",
    "lint": "npm --prefix coreader-app run lint",
    "format": "npm --prefix coreader-app run format",
    "help": "node ./scripts/help.js",
    "db:migrate": "node ./infra/db/scripts/migrate.js",
    "db:drop": "node ./infra/db/scripts/drop-database.js",
    "db:seed": "node ./infra/db/scripts/seed.js",
    "db:types": "node ./infra/db/scripts/generate-types.js",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "bson-schema-to-typescript": "^0.0.26",
    "dotenv-cli": "^11.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "mongodb": "^7.0.0",
    "prettier": "^3.7.4",
    "quicktype": "^23.2.6"
  },
  "dependencies": {
    "dotenv-mono": "^1.5.1"
  }
}
